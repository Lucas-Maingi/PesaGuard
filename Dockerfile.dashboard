# PesaGuard analyst dashboard (Streamlit)
FROM python:3.12-slim

WORKDIR /app

# libgomp1 provides libgomp.so.1, the OpenMP runtime that the XGBoost native
# library loads when the dashboard scores transactions locally.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY models/ models/
# Pre-scored test sample used by the live streaming simulation
COPY data/paysim_test_sample.csv data/paysim_test_sample.csv

EXPOSE 8501

CMD ["streamlit", "run", "src/dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
